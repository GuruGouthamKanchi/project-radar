{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        "peers": {
          "$peerId": {
            ".write": true,
            ".validate": "newData.hasChildren(['lat', 'lng', 'ts', 'peerId'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
            },
            "peerId": {
              ".validate": "newData.isString() && newData.val() === $peerId"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "accuracy": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
